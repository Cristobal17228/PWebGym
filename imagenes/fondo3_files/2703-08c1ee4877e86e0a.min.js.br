,{},{xB:"data:image/png;base64,"})},194721(e,t,a){let n=1464==a.j?[{id:"marketing_and_web",name:"Marketing, websites, and access",appTypes:[{id:"landing_page",name:"Landing / Campaign / Event Marketing Page",surface:"web",description:"A conversion-focused web page created to promote a product, launch, campaign, event, announcement, or specific call to action. Typical prompts mention a landing page, launch page, conference page, webinar page, campaign microsite, waitlist, lead-generation page, or product announcement. The main screen usually contains a prominent hero, headline, CTA, supporting feature sections, social proof, pricing or event details, and a footer. Use this instead of Brand / Corporate Website when the experience is centered on one campaign or conversion goal."},{id:"brand_website",name:"Brand / Corporate Website",surface:"web",description:"A public-facing website that represents a company, organization, product brand, nonprofit, or professional firm across multiple sections or pages. Common content includes the organization\u2019s mission, products or services, company story, leadership, customers, case studies, careers, news, and contact information. The experience usually has broad top-level navigation and communicates the overall brand rather than driving one narrowly defined campaign."},{id:"local_business_website",name:"Local Business / Services Website",surface:"web",description:"A website for a location-based business or individual service provider, such as a restaurant, salon, dentist, contractor, gym, repair shop, law office, or neighborhood store. Prompts often emphasize services, menus, opening hours, location, reviews, staff, pricing, appointment booking, directions, or contact details. Use this when the website\u2019s purpose is to help customers evaluate, locate, contact, or book a specific local business."},{id:"portfolio_website",name:"Portfolio / Agency Website",surface:"web",description:"A visually led website for a designer, artist, photographer, architect, developer, studio, consultancy, or creative agency to showcase completed work. The primary content is usually a project gallery, case studies, client work, capabilities, biography, awards, and contact information. Match prompts that emphasize showcasing work, personal branding, creative credibility, or attracting clients rather than selling products through a catalog."},{id:"blog_or_news",name:"Blog / Editorial / News Experience",surface:"web",description:"A publication-oriented website or app designed primarily for discovering and reading articles, stories, essays, news, reviews, or editorial content. Typical screens include a featured story, article feed, topic navigation, categories, publication branding, author information, reading views, and related content. Use this for news sites, online magazines, blogs, journals, and content publications. Route tools for writing or managing content to Notes / Writing / Content Editor instead."},{id:"marketing_email",name:"Marketing Email / Newsletter",surface:"web",description:"A standalone email communication or email-template experience, such as a promotional campaign, company newsletter, product update, event invitation, welcome email, or lifecycle message. The output is usually a vertically structured email with branded header content, modular sections, images, copy, calls to action, and an unsubscribe footer. Use this when the requested deliverable is an email or newsletter design, not an inbox application for reading and sending messages."},{id:"auth_or_onboarding",name:"Authentication / Signup / Onboarding Flow",surface:"web",description:"An account-access or first-use flow covering login, account registration, password recovery, verification, profile creation, workspace setup, permission requests, preferences, or introductory onboarding. Prompts may ask for a signup page, login experience, registration wizard, account setup, or multistep onboarding. The UI usually centers on forms, progress indicators, validation, authentication methods, and a clear sequence of steps rather than the app\u2019s core post-login functionality."}],aesthetics:[{id:"gallery_editorial",name:"Gallery Editorial",description:"Color palette: warm cream #F4EFE6, ink black #141210, one vermilion #D6431F used only for links and section marks. Type: high-contrast transitional serif display (Tiempos, Freight) with a small neutral grotesque for captions, metadata, and navigation. Structure: dense three- or four-column editorial grid with visible hairline column rules, numbered captions, running heads, several stories on screen at once, square corners, no shadows. Signature: visible hairline column rules and numbered figure captions \u2014 a magazine page, not a hero. Never: a single full-bleed hero image, large negative space, rule-free layouts, or a near-monochrome palette."},{id:"swiss_conversion",name:"Swiss Conversion",description:"Color palette: true white #FFFFFF, black #000000, one vermilion #E63312 reserved exclusively for the primary CTA. Type: neo-grotesque throughout (Helvetica Now, Neue Haas), tight tracking at display sizes, all-caps micro labels. Structure: everything flush left to a strict modular grid, hard section boundaries, 0px radii, no shadows, no photography \u2014 or at most one duotone image. Signature: one enormous flush-left headline set tight, with red appearing exactly once on the page. Never: centered composition, a product screenshot, pill buttons, soft shadows, or indigo and violet accents."},{id:"product_led_saas",name:"Product-Led SaaS",description:"Color palette: pale lavender-gray #F7F6FB sections alternating with white, indigo #4F46E5 primary, charcoal #1F2033 text. Type: contemporary geometric-humanist sans throughout (Inter, Geist); no serif anywhere. Structure: centered composition, pill-shaped buttons, 12px radii, a large rounded product screenshot with a soft diffuse shadow as the hero, a grayscale customer logo row, three-up feature modules. Signature: centered hero with a big rounded product UI screenshot floating beneath the headline. Never: flush-left Swiss composition, hairline rules, serif type, editorial photography, or vermilion."},{id:"quiet_luxury",name:"Quiet Luxury",description:"Color palette: ivory #F3F1EC and black #0D0D0D only. No accent color of any kind. Type: high-contrast didone serif used at small sizes, plus widely letterspaced small-caps sans for labels. Structure: extreme negative space, very little copy, full-bleed art-directed fashion or still-life photography, no rules, no dividers, no cards, no visible grid, no shadows. Signature: extreme scale contrast \u2014 tiny letterspaced type set against an enormous quiet image. Never: column rules, numbered captions, dense multi-story layouts, vermilion, or more than about thirty words on screen."},{id:"studio_color_fields",name:"Studio Color Fields",description:"Color palette: powder blue #DDE7F2, warm white #FAF8F3, ink navy #18263F, and one burnt orange #D9613E reserved for primary actions and small emphasis marks. Type: an expressive contemporary grotesque for headlines, paired with a neutral humanist sans for body copy, navigation, forms, and controls. Use sentence case and deliberate scale changes rather than all-caps display text. Structure: an asymmetric composition built from two or three large, edge-aligned color fields of different proportions. Place the headline and primary action in one field, the main image, product view, or form in another, and supporting content in smaller warm-white regions. Use 6px radii, crisp internal spacing, no gradients, and little or no shadow. Signature: an offset powder-blue field and warm-white content field connected by a single burnt-orange action. Never: a full-canvas saturated ground, a headline occupying most of the screen, acid-yellow details, typography used without any supporting content or imagery, a centered floating product screenshot, an exact 50/50 split, overlapping decorative shapes, or a multicolor palette."},{id:"friendly_consumer",name:"Friendly Consumer",description:"Color palette: warm peach-tinted off-white #FDF6F0, coral #FF6B4A primary, deep warm brown #3B2B24 text. Type: rounded geometric sans throughout (Poppins, Circular). Structure: 16\u201320px radii on everything, generous button and field sizing, soft diffuse shadows, one flat vector illustration featuring people, comfortable line lengths. Signature: rounded everything plus a single flat illustration \u2014 visibly warm and soft. Never: serif type, hairline rules, 0px corners, blue or navy accents, documentary photography, or a thick color band."},{id:"civic_clarity",name:"Civic Clarity",description:"Color palette: pure white, near-black #0B0C0C, one ultramarine #1D4ED8, plus a solid ultramarine band across the top of the page. Type: open humanist sans (Public Sans, Source Sans), large sizes, high x-height. Structure: 0px radii, no shadows, no cards, underlined text links, thick 3px focus outlines, stacked single-column sections, documentary photography only. Signature: solid color band across the top, underlined links, and zero rounding anywhere. Never: rounded corners, soft shadows, vector illustration, gradients, coral or warm neutrals."},{id:"split_screen_narrative",name:"Split-Screen Narrative",description:"Color palette: left half deep forest #14261F carrying full-bleed photography; right half bone #F6F3EC carrying the functional content. Accent is a muted brass #B8934A. Type: transitional serif on the narrative half, precise neutral sans on the functional half. Structure: a literal 50/50 vertical division running edge to edge, full height, with a hard uninterrupted seam. Shared baseline and margin system across both halves. Signature: the hard vertical seam itself \u2014 two worlds, one alignment system. Never: soft or gradient transitions, overlapping panels, three or more zones, a horizontal split, or a full-width hero above the split."}]},{id:"commerce_and_finance",name:"Commerce and finance",appTypes:[{id:"commerce_catalog",name:"Commerce Catalog / Marketplace / App Store",surface:"web",description:"A consumer browsing experience for discovering and evaluating products, services, applications, digital goods, or marketplace listings. Common elements include search, categories, filters, product cards, ratings, pricing, recommendations, featured collections, and product-detail views. Use this for online stores, marketplaces, app stores, product catalogs, and shopping-discovery experiences. Route prompts focused primarily on payment completion to Cart / Checkout / Subscription Flow."},{id:"checkout_flow",name:"Cart / Checkout / Subscription Flow",surface:"web",description:"A transaction-completion experience in which the user reviews a purchase, chooses a plan, enters delivery or billing information, submits payment, and receives confirmation. It includes shopping carts, checkout pages, subscription selection, upgrade flows, paywalls, billing forms, order summaries, promo codes, and purchase confirmations. Match this when the prompt focuses on converting an already selected item or plan into a completed purchase rather than browsing a catalog."},{id:"ticketing_app",name:"Event Discovery / Ticketing App",surface:"web",description:"An application for finding, comparing, saving, and purchasing access to concerts, performances, conferences, sports events, classes, festivals, or local activities. Typical screens include event feeds, calendars, location and date filters, venue information, ticket availability, seat selection, pricing tiers, saved events, and digital tickets. Use this instead of a marketing event page when users are expected to browse or transact across multiple events."},{id:"point_of_sale_app",name:"Point-of-Sale App",surface:"web",description:"A merchant-facing interface used by cashiers, restaurant staff, retail associates, or service workers to process in-person sales. The primary screen commonly includes a product or menu grid, an active order, modifiers, quantities, discounts, taxes, customer information, totals, payment methods, and receipt controls. It may also include shift status, table management, inventory, or transaction history. Do not use this for the consumer-facing side of online checkout."},{id:"loyalty_app",name:"Loyalty / Rewards App",surface:"mobile",description:"A customer membership experience centered on earning, tracking, and redeeming points, credits, stamps, discounts, coupons, or status benefits. Typical prompts mention loyalty programs, memberships, rewards cards, referral bonuses, VIP tiers, punch cards, cashback, or brand-specific offers. Core screens usually show points balance, membership level, progress toward the next reward, available offers, recent activity, and redemption actions."},{id:"banking_app",name:"Banking / Personal Finance / Wealth App",surface:"mobile",description:"A consumer financial application for managing bank accounts, balances, transactions, transfers, bills, budgets, savings goals, credit, cash flow, or overall net worth. The main screen often provides account summaries, recent activity, spending breakdowns, financial trends, alerts, and common money actions. Use this for everyday banking and personal wealth overviews. Route prompts centered on securities, live markets, and trade execution to Investing / Trading / Portfolio App."},{id:"investing_app",name:"Investing / Trading / Portfolio App",surface:"web",description:"A financial-market application for researching, buying, selling, and monitoring stocks, funds, cryptocurrencies, commodities, or other investments. Common screens include market charts, watchlists, asset details, portfolio positions, gains and losses, allocation views, news, order tickets, and buy or sell controls. Match prompts that mention trading, brokerage, investing, stock portfolios, crypto exchanges, or market analysis rather than ordinary bank-account management."},{id:"insurance_app",name:"Insurance / Claims App",surface:"web",description:"An insurance-focused application for viewing coverage, comparing or purchasing policies, paying premiums, managing beneficiaries, filing claims, uploading evidence, and tracking claim status. It may cover auto, home, life, travel, business, or health insurance. Typical screens include policy cards, coverage summaries, deductibles, documents, quotes, claim timelines, and contact with an adjuster. Use Patient / Healthcare Portal when the main relationship is with a healthcare provider rather than an insurer."}],aesthetics:[{id:"institutional_ledger",name:"Institutional Ledger",description:"Color palette: ivory #F5F2EA, navy #10233F, burgundy #7A2230 for negative or flagged states. Type: transitional serif headings with monospaced tabular numerals for all figures. Structure: hairline-ruled tables, precise right-aligned columns, list-first layout, no cards, no shadows, 0px radii, restrained thin-line charts. Signature: a long hairline-ruled ledger table with right-aligned monospaced figures. Never: rounded cards, elevation, a single oversized balance, mint or emerald accents."},{id:"consumer_fintech",name:"Consumer Fintech",description:"Color palette: white and pale mint-gray #F1F6F3, deep navy #12213D text, one emerald #0FA36B. Type: humanist sans throughout (Inter); no serif, no monospace. Structure: 12px radii, soft low-contrast cards, chip-shaped filters, comfortable density, a compact sparkline, clear transaction rows with merchant avatars. Signature: one oversized balance figure at the top with a small sparkline beneath it. Never: monospaced type, hairline ledger tables, serif headings, burgundy, dark grounds."},{id:"slate_precision",name:"Slate Precision",description:"Color palette: cool cloud gray #F3F5F7, white primary surfaces, slate #24313D, one cobalt #315EFB, with muted green and red reserved for meaningful positive and negative states. Type: contemporary neo-grotesque for navigation and content, with tabular numerals for money and quantities; monospace limited to IDs or timestamps. Structure: a three-zone workspace with a compact navigation or filter rail, one broad primary content surface, and a narrow persistent summary or action rail. Use 6px radii, 1px borders, no visible shadows, and moderate information density. The central surface can hold a chart, comparison, product detail, policy detail, transaction history, or ticket inventory without fragmenting the screen into many small panels. Signature: one broad working surface anchored by a slim contextual summary rail. Never: a near-black canvas, monospace throughout, five or more simultaneous micro-panels, wall-to-wall data, glow, a giant isolated figure, or decorative market-terminal styling."},{id:"editorial_commerce",name:"Editorial Commerce",description:"Color palette: warm white #FAF7F2, black, one deep ink blue #1B3A6B. Type: display serif for product and section names, small neutral grotesque for pricing and metadata. Structure: asymmetric magazine grid, at most two or three products per row, generous crops, written captions, minimal metadata, no badges, no star-rating rows. Signature: one product image breaking the grid at much larger scale than its neighbors. Never: a uniform card grid, sale badges, dark grounds, letterspaced caps as the dominant treatment."},{id:"premium_retail",name:"Premium Retail",description:"Color palette: deep near-black #0C0C0C ground, bone #EDE9E3 type. No accent color. Type: neutral grotesque only, with wide letterspacing on small caps. Structure: a single art-directed product photograph occupying most of the canvas, minimal navigation, tiny metadata, no rules, no cards, 0px radii. Signature: one hero product image at near-full scale with the product name in small letterspaced caps. Never: a white or warm ground, serif display type, magazine grids, captions, or any accent color."},{id:"deep_teal_service",name:"Deep Teal Service",description:"Color palette: deep teal #123E3A, warm ivory #F8F4EC, mist green #DDE8E2, charcoal #202927, and one muted coral #D86F52 reserved for the primary action or urgent status. Type: an open humanist sans throughout, with tabular numerals for prices, balances, quantities, dates, and totals. Monospace is limited to reference numbers or timestamps. Structure: a broad deep-teal header or application frame occupies the upper portion of the screen and contains identity, navigation, status, or summary information. A large warm-ivory workspace below contains forms, selections, account details, transaction rows, policy information, or product content. Use mist-green contextual panels, 10px radii, fine warm-gray borders, and minimal elevation. Signature: a deep-teal upper frame surrounding a calm ivory transactional workspace, with one coral action clearly prioritized. Never: a purely black-and-white interface, an achromatic form divided only by hairline rules, a single red button as the only color, a full-screen dark ground, a solid vertical color field consuming one-third of the canvas, stacked pale-mint cards, one enormous total, or photography dominating the interaction."},{id:"monochrome_commerce",name:"Monochrome Commerce",description:"Color palette: warm white #FAFAF7, white primary surfaces, fog gray #E8E9EB, graphite #292B2F, and ink black #111111. Interface chrome uses no chromatic accent. Product, venue, or event imagery may retain natural color when required by the bucket, but it should appear inside simple, consistently cropped frames. Type: a contemporary neutral grotesque with sturdy medium weights for labels and actions, plus tabular numerals for prices, quantities, balances, and totals. Structure: organize the interface as a clear matrix of medium-density modules, lists, or item rows with 8px radii and precise 1px borders. Use black-filled selected states and anchor the main action, current order, purchase summary, or account action in a persistent black band along one edge of the screen. Keep supporting controls compact and avoid decorative elevation. Signature: a solid black action band anchoring an otherwise pale, highly structured commerce interface. Never: a dark graphite canvas across the entire screen, saturated category-colored tiles, amber action keys, oversized industrial typography, thick panel separations, a giant running total dominating the composition, rainbow category coding, glossy buttons, or luminous status effects."},{id:"aubergine_color_block",name:"Aubergine Color-Block",description:"Color palette: warm bone #F7F2EA, deep aubergine #4B2B4F, pale mauve #E9DDE8, and one muted coral #C96B57 reserved for a primary action or important status. Type: geometric-humanist sans throughout, with tabular numerals for financial and transactional information. Structure: an asymmetric 30/70 composition in which a solid aubergine navigation, membership, account, or summary field sits beside a warm light content workspace. Use crisp rectangular modules, 8px radii, light borders, no gradients, and restrained elevation. The color blocks should define information hierarchy rather than act as decoration. Signature: a deep aubergine side field paired with a warm, highly functional main workspace. Never: a full-canvas single color, one enormous number, black luxury styling, mint fintech cards, a uniform product grid, multicolor category tiles, or soft rainbow gradients."}]},{id:"work_and_developer_tools",name:"Work, data, and developer tools",appTypes:[{id:"analytics_dashboard",name:"Analytics / Admin / Enterprise Dashboard",surface:"web",description:"A data-dense business application for monitoring performance, managing operations, configuring a product, or administering an organization. Typical prompts mention dashboards, admin panels, KPI tracking, SaaS back offices, revenue analytics, user management, reporting, or business intelligence. Common screens include sidebar navigation, metric cards, charts, filters, tables, alerts, and recent activity. Use a more specific bucket when physical equipment, customer records, or support cases dominate the workflow."},{id:"iot_operations",name:"Industrial / IoT Operations and Control",surface:"web",description:"An operational interface for monitoring and controlling physical devices, factories, fleets, buildings, energy systems, infrastructure, sensors, or connected equipment. The product commonly displays telemetry, equipment status, alarms, environmental readings, maintenance schedules, maps, floor plans, network topology, and direct control actions. Match prompts involving industrial operations, smart-device control, plant monitoring, logistics control rooms, or IoT fleets rather than generic company analytics."},{id:"crm_workspace",name:"CRM / Directory / Customer Support Workspace",surface:"web",description:"A record-management workspace organized around customers, contacts, companies, leads, employees, cases, or support tickets. Common screens use list-and-detail layouts with searchable records, profile information, communication history, notes, ownership, status, tasks, and an activity timeline. Use this for CRM systems, contact directories, recruiting databases, account management, help desks, and case-management tools where the central activity is managing relationships or resolving individual cases."},{id:"calendar_app",name:"Calendar / Scheduling App",surface:"web",description:"A time-based application for viewing calendars, arranging meetings, booking appointments, coordinating availability, or managing schedules. Prompts may mention personal calendars, team scheduling, appointment booking, class schedules, shift planning, meeting coordination, or reservation time slots. Typical screens include month, week, day, and agenda views, event details, participant availability, recurrence settings, reminders, and event creation."},{id:"tasks_app",name:"Tasks / Projects / Kanban App",surface:"web",description:"A productivity application for planning and tracking work through tasks, projects, boards, lists, milestones, or workflows. Common concepts include to-do lists, Kanban columns, backlogs, assignees, due dates, priorities, dependencies, status, project progress, and team collaboration. Use this when the main goal is organizing work and moving items toward completion, rather than placing events on a calendar or editing structured data in a spreadsheet."},{id:"notes_editor",name:"Notes / Writing / Content Editor",surface:"web",description:"A text-centered application for creating, editing, organizing, and collaborating on notes, documents, articles, knowledge bases, journals, or long-form content. Typical screens include a document or notebook sidebar, rich-text editor, formatting controls, comments, tags, search, version history, and metadata. Match prompts for writing tools, note-taking apps, wiki editors, blogging editors, and document workspaces. Use Blog / Editorial / News Experience when users primarily consume published content."},{id:"spreadsheet_app",name:"Spreadsheet / Data Grid App",surface:"web",description:"A structured-data application based on editable rows, columns, cells, formulas, and tables. Prompts may request a spreadsheet, database-like grid, budgeting sheet, data tracker, planning model, or collaborative worksheet. Common UI elements include a formula bar, sheet tabs, row and column controls, sorting, filtering, cell formatting, charts, pivots, and calculations. Use a dashboard bucket when the data is primarily viewed rather than directly edited in a grid."},{id:"slide_editor",name:"Presentation / Slide Editor",surface:"web",description:"An authoring tool for creating, arranging, editing, and presenting slide-based content. Typical screens include a slide-thumbnail navigator, central canvas, layout and object controls, text and media insertion, speaker notes, comments, transitions, and presentation controls. Match prompts for presentation makers, pitch-deck editors, slideshow tools, or collaborative slide software. This bucket represents the editor itself, not a single finished marketing page or static presentation image."},{id:"coding_ide",name:"Coding IDE",surface:"web",description:"A development environment centered on writing, navigating, running, testing, and debugging source code. The main screen generally includes a file tree, tabbed code editor, syntax highlighting, terminal, diagnostics, debugger, source-control tools, and run or build actions. Use this for code editors, browser IDEs, notebook-style programming environments, or developer workspaces where code authoring is the primary task. Route cloud-resource management to Developer Portal / API / Cloud Console."},{id:"developer_console",name:"Developer Portal / API / Cloud Console",surface:"web",description:"A developer-facing product for managing software projects, APIs, infrastructure, deployments, cloud resources, integrations, credentials, usage, or technical documentation. Typical screens show API keys, request logs, usage metrics, environments, deployments, service status, billing, resource lists, and documentation navigation. Use this when developers are configuring or operating systems rather than primarily writing source code inside an editor."}],aesthetics:[{id:"clean_enterprise",name:"Clean Enterprise",description:"Color palette: white content area with a pale blue-gray #EEF2F7 sidebar, enterprise blue #2563EB, charcoal #20242B text, chart palette drawn entirely from the blue family. Type: contemporary neutral sans throughout (Inter); no monospace. Structure: left sidebar with grouped, labeled sections; a dense zebra-striped data table as the centerpiece; 6px radii; 1px borders; filter chips above the table. Signature: the zebra-striped table is the screen \u2014 charts are secondary. Never: warm or greige neutrals, a card or board layout, top-bar-only navigation, monochrome charts, lavender, or 0px radii."},{id:"swiss_operations",name:"Swiss Operations",description:"Color palette: true white, black, one signal red #E01B24 for exceptions only. Nothing else. Type: neo-grotesque with all-caps micro labels and tabular numerals. Structure: top-bar navigation only \u2014 no sidebar. No filled surfaces anywhere: tables are defined by hairline rules, charts are thin black lines with no fills, 0px radii, no shadows, exact baseline alignment. Signature: entirely achromatic except red exception marks, with unfilled line charts. Never: a sidebar, tinted panels, zebra striping, colored chart fills, rounded corners, or blue."},{id:"dark_developer",name:"Dark Developer",description:"Color palette: charcoal #16181D with layered #1E2126 panels, off-white #E6E8EC text, muted teal #3FA3A0 accent. Type: compact sans for navigation and chrome; monospace for code, logs, paths, and metadata. Structure: sharp panel boundaries, dense but readable spacing, 4px radii, no glow, no gradients, a prominent monospaced log or code region. Signature: a large monospaced code or log panel with syntax color as the only real chroma. Never: glow, gradients, warm neutrals, amber, translucency, or large radii."},{id:"paper_and_ink_analytics",name:"Paper and Ink Analytics",description:"Color palette: warm off-white #F7F4ED, black ink, one muted rust #A85434. Type: serif for insight statements, set large; very small sans for labels and axes. Structure: asymmetric editorial grid, thin black chart lines, no cards, no sidebar, no metric-card wall, generous margins. Signature: a full-sentence serif insight headline treated as the largest element on screen, with charts subordinate to it. Never: a grid of metric cards, colored chart fills, sidebars, blue, or a dark ground."},{id:"cobalt_control",name:"Cobalt Control",description:"Color palette: full-bleed cobalt #1F3FA8 with solid lighter and darker blue panels for hierarchy, white type. No cyan, no second accent. Type: wide geometric sans throughout at generous sizes. No monospace. Structure: solid tonal panels with soft 8px radii, spacious padding, moderate density, no grid lines, no rules, no wireframe elements. Signature: hierarchy achieved purely through blue luminosity across large solid fields. Never: cyan, hairline grids, rulers, node diagrams, monospace, technical annotation, or a near-black ground."},{id:"soft_collaboration",name:"Soft Collaboration",description:"Color palette: greige #F5F2EE, muted lavender #8B7FC7 primary, sage #7E9478 secondary, warm charcoal text. Type: friendly humanist sans, comfortable sizes. Structure: a card and column board layout \u2014 not tables. 12\u201314px radii, restrained avatars, light borders, generous spacing. Signature: rounded cards arranged in columns on a warm neutral ground. Never: dense data tables, zebra rows, navy, cobalt, hairline rules, 0px radii, or monospace."},{id:"mineral_workbench",name:"Mineral Workbench",description:"Color palette: pale mineral green-gray #EDF3F1, white primary surfaces, deep petrol #173F3B, graphite #25302E, pale sand #EFE3D5, and one muted clay #C66A4E reserved for primary actions, selected states, or important exceptions. Charts should use two or three petrol-derived tones with clay appearing only as a focused highlight. Type: contemporary humanist sans for navigation, labels, and content, with tabular numerals for metrics and structured data; monospace is limited to code, IDs, formulas, or timestamps. Structure: a solid petrol command bar spans the top of the application, followed by a warm, moderately dense workspace. Use one broad primary surface for the table, board, calendar, editor, chart, or document, paired with a narrow contextual rail for filters, details, or actions. Use 8px radii, fine green-gray borders, solid tinted surfaces, and almost no shadow. Signature: a deep petrol command bar above a pale mineral workspace, with one carefully placed clay interaction state."},{id:"executive_minimal",name:"Executive Minimal",description:"Color palette: pale stone #F2F0EC, charcoal #22201C, one deep green #1F5C42. Type: large neutral sans; figures set very large in tabular numerals. Structure: at most four modules, enormous negative space, no sidebar, no nav rail, no tables, one or two supporting charts at most. Signature: three or four very large numbers effectively constituting the whole screen. Never: dense tables, sidebars, multi-panel dashboards, blue, or small type."}]},{id:"communication_and_media",name:"Communication, social, and media",appTypes:[{id:"email_client",name:"Email Client",surface:"web",description:"A communication application for receiving, reading, organizing, searching, composing, and sending email. Common screens include an inbox, folders or labels, message list, selected conversation, attachments, search, filters, and a compose action. Prompts may reference an inbox, mail app, business email, threaded email, or email productivity tool. Do not use this for designing a marketing email or newsletter template."},{id:"chat_app",name:"Chat / Team Messaging App",surface:"web",description:"A real-time or near-real-time messaging application for private conversations, group chats, workplace channels, or team collaboration. Typical UI includes workspace or conversation navigation, message history, threads, reactions, presence, attachments, voice notes, search, and a message composer. Use this when direct or group communication is the primary experience. Route public feeds, creator content, and follower networks to Social Network / Community / Short-Form Feed."},{id:"social_feed",name:"Social Network / Community / Short-Form Feed",surface:"web",description:"A public or semi-public social product for discovering, posting, and interacting with user-generated content. It covers social networks, creator feeds, community platforms, forums, discussion boards, and short-form video feeds. Common features include profiles, followers or memberships, posts, media, comments, reactions, sharing, moderation, and personalized recommendations. Use Chat / Team Messaging App when private conversations are the main purpose rather than a shared content feed."},{id:"dating_app",name:"Dating / Matchmaking App",surface:"mobile",description:"A relationship-discovery application for browsing profiles, expressing interest, receiving matches, evaluating compatibility, and starting conversations. Typical screens include profile cards, photos and biographies, swipe or like controls, prompts, preference filters, compatibility indicators, match queues, safety features, and post-match messaging. Match prompts mentioning dating, matchmaking, singles, romance, or partner discovery rather than general-purpose social networking."},{id:"calling_app",name:"Voice / Video Calling App",surface:"web",description:"A synchronous communication product centered on phone calls, video meetings, conferencing, or live collaboration. Common screens include contacts, recent calls, participant grids, active-speaker layouts, waiting rooms, call status, microphone and camera controls, screen sharing, captions, chat, and call recording. Use this when the primary action is joining or conducting live calls rather than exchanging asynchronous messages."},{id:"video_streaming_app",name:"Video / Movie Streaming App",surface:"web",description:"A media-consumption product for discovering and watching films, television, episodic video, or general long-form streaming content. Typical screens include a featured-title hero, content rails, genres, search, profiles, continue-watching history, watchlists, title details, episode selection, and a video player. Use Sports Hub for sports-first streaming and Social Network / Community / Short-Form Feed for creator-driven short-form video."},{id:"sports_hub",name:"Sports Hub",surface:"web",description:"A sports-specific application combining live scores, schedules, standings, teams, players, statistics, news, highlights, fantasy information, or live-stream access. The primary screen may show games currently in progress, league navigation, scoreboards, match details, player stats, upcoming fixtures, and stream controls. Use this whenever following sports competition is the dominant goal, even when streaming is part of the experience."},{id:"music_player",name:"Music / Audio Player",surface:"web",description:"A listening application for discovering, organizing, and playing music, podcasts, radio, audiobooks, or other recorded audio. Typical screens include a library, playlists, albums or shows, search, recommendations, queue, now-playing artwork, playback controls, lyrics, and saved content. Match prompts for streaming audio and media playback. Route prompts involving composing, recording, mixing, or performing music to Music Creation / Instrument App."}],aesthetics:[{id:"quiet_personal",name:"Quiet Personal",description:"Color palette: warm paper white #FBFAF7, near-black #1A1917, one sage #6E8B72. Type: humanist sans set noticeably larger than typical UI. Structure: a single centered column with no sidebar, very low density, 16px radii on message rows or content blocks, near-invisible chrome, few icons, no badges or counters competing for attention. Signature: one generous centered column with almost no visible controls. Never: sidebars or navigation rails, dense lists, small type, navy or cool gray, unread count badges, presence dots."},{id:"professional_collaboration",name:"Professional Collaboration",description:"Color palette: cool gray #F0F2F5 chrome with white content, deep navy #1F2A44 text, one blue #3B6FD4. Type: crisp neutral sans at small sizes; tabular numerals for counts. Structure: a two-level left navigation \u2014 a narrow workspace rail plus a dense channel or thread list \u2014 4px radii, tight rows, bold unread states, small avatars, precise alignment. Signature: the persistent two-level navigation rail with a dense channel list. Never: warm neutrals, large type, single-column layouts, sage, generous spacing, or serif."},{id:"reading_first_conversation",name:"Reading-First Conversation",description:"Color palette: soft warm white #F7F5F0, ink #1B1C1D, deep forest #315B4A, and pale sage #E8EEE9 for selected or contextual surfaces. Type: readable humanist serif for substantial posts, messages, or article-like content; neutral sans for navigation, authorship, timestamps, reactions, and controls. Structure: a broad primary conversation column paired with a narrow context, participants, or related-content rail. Represent reply hierarchy through restrained indentation and subtle vertical rules rather than enclosing every contribution in a card. Use 4px radii, comfortable reading widths, and clear authorship transitions. Signature: a long-form conversation with an elegant nested-reply structure and a calm contextual rail. Never: newspaper-style multi-column composition, drop caps, running heads, several unrelated stories competing on screen, a centered low-density chat column, a giant portrait card, or illustration replacing all user content."},{id:"photo_first_monochrome",name:"Photo-First Monochrome",description:"Color palette: white, black, layered gray. No accent color. Type: neutral sans, small, quiet captions. Structure: a rigorous edge-to-edge image grid with uniform gutters, minimal navigation, visually recessive actions, 0px radii on images. Signature: the uncompromising uniform image grid itself. Never: color accents, serif type, rounded photo corners, editorial rules, or decorative chrome."},{id:"warm_relationship",name:"Warm Relationship",description:"Color palette: cream #F7EFE7, muted blush #E8C4BC, deep brown #3A2A24, charcoal. Type: high-contrast didone serif for names and content emphasis, friendly sans for controls. Structure: image-led \u2014 one large portrait photograph dominating the canvas with 20px rounded corners, minimal supporting type, generous spacing, no rules, no columns. Signature: a single large rounded portrait card occupying most of the screen. Never: multi-column text, hairline rules, drop caps, newsprint gray, dense feeds, or illustration in place of photography."},{id:"dark_immersive",name:"Dark Immersive",description:"Color palette: near-black #0A0A0B, off-white type, one deep red #B3241F. Type: neutral sans, restrained. Structure: edge-to-edge media or artwork, controls receding until needed, thin progress elements, minimal overlays, precise spacing. Signature: full-bleed artwork with a single thin progress indicator as the only chrome. Never: glow, neon, multicolor gradients, condensed all-caps type, horizontal bands, or tickers."},{id:"broadcast_utility",name:"Broadcast Utility",description:"Color palette: light mineral #F2F0EA, warm white #FAF9F6, ink navy #152B43, pale sky #DCE7EF, and one signal orange #E15B36 reserved for live, urgent, or currently active information. Type: a sturdy condensed grotesque for section headings, scores, times, and short labels; a compact neutral sans for detail rows, descriptions, and controls; tabular numerals for timing and statistics. Structure: use stacked full-width information bands, tight but legible rows, a narrow running-detail strip along one edge, and a strong horizontal rhythm for current, upcoming, and completed information. Alternate warm-white and pale-sky bands to establish hierarchy. Use 0\u20134px radii, fine navy rules, and no visible shadows. Signature: alternating pale-sky and warm-white information bands marked by a single orange live indicator. Never: a near-black full-canvas background, deep red as the primary accent, red and amber used together, edge-to-edge cinematic artwork, controls that disappear into media, a lone thin progress bar as the only visible interface, rounded card stacks, gradient backgrounds, glow, or translucent panels."},{id:"structured_social",name:"Structured Social",description:"Color palette: cool porcelain #F6F7F9, white content surfaces, graphite #20242A, deep plum #5A3E8C, and pale lilac #EEE9F6 for active or selected states. Type: contemporary humanist sans throughout, with compact tabular figures for counts and durations. Structure: a disciplined three-zone application shell with compact icon-and-label navigation, a well-proportioned central mixed-media feed, and a subdued discovery, event, or context rail. Use 10px radii, fine neutral borders, restrained elevation, and consistent post anatomy. Engagement controls should be compact and visually secondary to the content. Signature: a strong central feed with plum active states and a slim contextual right rail. Never: a full-screen monochromatic blue treatment, luminosity-only hierarchy, broadcast bands, tickers, full-bleed dark media, newspaper rules, or one oversized profile portrait."}]},{id:"lifestyle_and_travel",name:"Education, health, lifestyle, and travel",appTypes:[{id:"learning_app",name:"Learning / Course / Quiz App",surface:"web",description:"An educational product for teaching concepts, delivering courses, guiding lessons, practicing skills, or assessing knowledge. It covers learning platforms, language-learning apps, tutoring experiences, course players, test preparation, quiz apps, and interactive exercises. Common elements include lesson navigation, progress, instructional content, questions, feedback, scores, streaks, levels, certificates, and recommended next activities."},{id:"fitness_app",name:"Fitness / Health Tracking App",surface:"mobile",description:"A consumer wellness application for tracking exercise, activity, sleep, nutrition, habits, physiological measurements, or personal health goals. Typical screens show daily summaries, rings or progress indicators, workouts, trends, goals, wearable data, health metrics, streaks, and coaching recommendations. Use this for self-directed wellness and fitness. Route clinical records, provider communication, and medical appointments to Patient / Healthcare Portal."},{id:"healthcare_portal",name:"Patient / Healthcare Portal",surface:"web",description:"A patient-facing clinical application for interacting with healthcare providers and managing medical care. Common functions include scheduling appointments, viewing lab results, checking medications, reviewing visit summaries, messaging clinicians, completing forms, paying bills, accessing care plans, and managing referrals. Use this when the experience involves a doctor, clinic, hospital, or formal medical record rather than general fitness tracking or insurer claim management."},{id:"recipe_app",name:"Meal Planning / Recipe App",surface:"mobile",description:"A food-planning application for discovering recipes, following cooking instructions, organizing saved dishes, building weekly meal plans, and generating grocery lists. Typical screens include recipe cards, ingredients, preparation steps, servings, nutrition, dietary filters, meal calendars, pantry information, and shopping lists. Use this for home cooking and food planning rather than restaurant discovery, grocery commerce, or food-delivery tracking."},{id:"travel_booking_app",name:"Travel Booking App",surface:"web",description:"A trip-commerce application for searching, comparing, and reserving flights, hotels, trains, rental cars, cruises, or vacation packages. Typical flows begin with destination, dates, travelers, and preferences, followed by results, filters, maps, fare or room details, checkout, and itinerary management. Use this for advance travel planning and reservation. Route real-time rides, local navigation, or delivery tracking to Mobility / Delivery / Navigation App."},{id:"mobility_app",name:"Mobility / Delivery / Navigation App",surface:"mobile",description:"A map-centered application for moving people or goods in real time. It includes ride-hailing, taxi booking, food or package delivery, courier tracking, turn-by-turn navigation, fleet movement, and in-vehicle interfaces. Typical screens show current location, route, destination, pickup and drop-off points, ETA, driver or courier status, order progress, map controls, and trip actions. The key distinction is live movement rather than advance travel reservation."}],aesthetics:[{id:"calm_clinical",name:"Calm Clinical",description:"Color palette: true white with pale blue #EAF1F8 panels, navy #17395C, teal #1B8A8F. Type: highly legible humanist sans throughout. Structure: 8px radii, simple line icons at one stroke weight, generous spacing, clear timelines and result rows, plain-language status, obvious next actions. Signature: a clear chronological result or visit timeline with plain-language status labels. Never: dark grounds, serif type, amber, ruled paper textures, or imagery of bodies."},{id:"humanist_care",name:"Humanist Care",description:"Color palette: warm white #FBF7F2, dusty blue #6E84A0, muted terracotta #C66F5B, pale sand #EFE5DA, and charcoal #2D2B28. Type: humanist serif for reassuring summaries, recommendations, or lesson introductions; open humanist sans for tasks, schedules, results, controls, and quantitative information. Structure: a balanced two-column layout pairing a calm narrative overview with a crisp stack of next actions, appointments, lessons, recommendations, or itinerary items. Use solid tinted surfaces, 10px radii, minimal shadows, and either one small documentary image or restrained line illustration. Signature: a warm narrative summary panel placed beside an immediately actionable next-step stack. Never: paper texture, ruled journal lines, hand-drawn marks, progress rings as the main visual, full-bleed aspirational photography, a cool clinical dashboard, or a dark single-task composition."},{id:"sunlit_modular",name:"Sunlit Modular",description:"Color palette: warm ivory #FBF8F0, pale butter #F1E3A4, ink navy #1D2B49, and one clear cobalt #355FC7 for navigation, actions, and selected states. Type: a contemporary geometric-humanist sans throughout, with slightly compressed headings, highly readable body text, and tabular numerals for dates, measurements, progress, and schedules. Structure: use an asymmetric modular layout with one broad visual or informational panel and a narrower stack of supporting actions, recommendations, activities, results, or itinerary items. The main panel may contain a content-relevant diagram, map, recipe, workout, lesson, plan, or summary rather than generic decorative illustration. Use 10px radii, thin navy-tinted borders, flat filled surfaces, and no diffuse shadows. Signature: a large pale-butter content panel balanced by compact cobalt action and navigation elements. Never: a numbered chapter list, serif headings, formal figure plates, anatomical or specimen imagery, paper or book textures, full-bleed aspirational photography, a linear sequence of locked and completed steps, a calendar-dominant grid, a dark canvas, pastel rainbow coding, or cartoon mascots."},{id:"guided_progress",name:"Guided Progress",description:"Color palette: white, one violet #6D4AFF, charcoal text, pale violet tints for completed states. Type: geometric sans throughout. Structure: a linear step path with visible completion states, modular activity blocks, 10px radii, restrained progress indicators, minimal and purposeful rewards. Signature: an explicit linear step path where completed, current, and locked states are instantly distinguishable. Never: cartoon characters, mascots, confetti, badge walls, serif type, textured grounds, or photography."},{id:"editorial_journey",name:"Editorial Journey",description:"Color palette: cool light stone #F0EEEA \u2014 not cream \u2014 with black type and one deep ink accent #1F3A5F. Type: high-contrast display serif for headlines, compact sans for schedules, times, and metadata. Structure: photography-led with a full-bleed destination image, an asymmetric grid, large scale contrast, and itinerary, map, or schedule detail integrated cleanly into an overlaid panel. Signature: a full-bleed photograph with an overlaid asymmetric itinerary panel. Never: sage or clay palettes, ruled paper texture, ring progress modules, journal framing, or photography-free layouts."},{id:"modern_field_guide",name:"Modern Field Guide",description:"Color palette: sand #E6DDCB, forest green #23412F, navy #1D2E44, charcoal. Type: restrained slab serif for headings, monospace for utility labels and coordinates. Structure: topographic contour lines, map elements, coordinate readouts, durable rectangular information modules, documentary photography, 4px radii. Signature: contour map lines with monospaced coordinate labels. Never: nostalgic badges or crests, distressed textures, leather or stamped-paper effects, serif display headlines, or full-bleed aspirational photography."},{id:"dark_focus",name:"Dark Focus",description:"Color palette: deep warm charcoal #1A1816 \u2014 no navy, no blue \u2014 with off-white text and one amber #D99A3E. Type: neutral sans, comfortable reading sizes. Structure: a single centered column carrying the active lesson, exercise, care task, recipe, or planning step. Secondary navigation dimmed nearly to invisibility. A single thin progress line. No panel layering, no multi-column layouts. Signature: one task centered in warm darkness with everything else faded almost out. Never: navy, teal, or blue accents; multi-panel layouts; high-contrast yellow; large touch targets; visible focus outlines as a design feature."},{id:"structured_planner",name:"Structured Planner",description:"Color palette: cool white #F6F7F8, charcoal #23272E, deep teal #1E6A6B, and a small set of low-saturation sand, blue, or dusty-rose tints used only to distinguish categories. Type: geometric-humanist sans at conventional product sizes, with tabular numerals for dates, times, measurements, and progress. Structure: a planner-like composition with a compact utility bar, a primary calendar, schedule, list, or itinerary grid, and a narrow contextual panel. Use 8px radii, subtle borders, minimal elevation, clear filtering, and a visible current-state marker. The same system should work for lessons, meals, trips, care plans, routines, or fitness activities. Signature: a strongly structured sequence or time grid with one thin teal current-state marker. Never: black, white, and yellow only; unusually oversized typography; thick focus outlines as the primary visual motif; a card-free linear government-style flow; paper texture; full-bleed photography; or a centered dark task screen."}]},{id:"system_and_creative_tools",name:"System and creative tools",appTypes:[{id:"os_shell",name:"Operating System Shell / System Search",surface:"web",description:"A system-level interface representing a mobile or desktop operating environment rather than a single application. It may include a home screen, desktop, app launcher, dock, taskbar, start menu, app switcher, notifications, widgets, status controls, or global search. Match prompts asking for an operating-system concept, desktop shell, mobile home experience, launcher, or system-wide search. Use Settings / File Management Tool for a specific utility inside the system."},{id:"settings_or_files",name:"Settings / File Management Tool",surface:"web",description:"A system or application utility for configuring preferences, managing accounts and permissions, browsing storage, or organizing files and folders. Typical layouts use sidebar categories, folder trees, file lists, detail panes, toggles, dropdowns, storage indicators, metadata, and permission controls. Use this for settings panels, control panels, file explorers, cloud drives, download managers, and storage-management tools rather than a complete operating-system shell."},{id:"weather_app",name:"Weather App",surface:"mobile",description:"An application focused on current and forecasted weather conditions for one or more locations. Common screens include current temperature, conditions, hourly and multiday forecasts, precipitation, wind, sunrise and sunset, air quality, radar or map views, saved locations, and severe-weather alerts. Match prompts mentioning weather, climate conditions, forecasts, storms, or local atmospheric information."},{id:"calculator_app",name:"Calculator / Numeric Utility",surface:"mobile",description:"A focused utility for entering numbers or expressions and producing calculations, conversions, or quantitative results. It includes basic and scientific calculators, financial calculators, unit converters, currency converters, tip calculators, loan calculators, and similar single-purpose tools. Typical screens feature an expression display, keypad or structured inputs, operation controls, results, and calculation history. Use Spreadsheet / Data Grid App for broader tabular modeling."},{id:"media_editor",name:"Photo / Video Editing Tool",surface:"web",description:"A creative application for importing, manipulating, enhancing, and exporting photographs or video footage. Typical interfaces contain a media canvas or video preview, layers or timeline, asset browser, crop and transform tools, color adjustments, filters, effects, captions, audio controls, and export settings. Use this when the source material is raster imagery or video. Route vector illustration, interface design, and reusable components to Design / Drawing / Component Tool."},{id:"design_tool",name:"Design / Drawing / Component Tool",surface:"web",description:"A visual-authoring application for creating interface designs, illustrations, diagrams, vector artwork, prototypes, animations, components, or design systems. Common elements include an infinite or framed canvas, layers, assets, properties, alignment tools, paths, components, variants, interaction controls, accessibility checks, and animation settings. Use this for UI design, drawing, prototyping, component-building, and vector creation rather than photo retouching or timeline-based video editing."},{id:"music_creation_app",name:"Music Creation / Instrument App",surface:"web",description:"A creative audio application for composing, recording, performing, sequencing, arranging, or mixing music. It includes digital audio workstations, beat makers, loop tools, synthesizers, drum machines, virtual pianos, guitar interfaces, and other software instruments. Typical screens contain tracks, waveforms, step sequencers, pads, keys, mixers, effects, timelines, transport controls, and recording actions. Use Music / Audio Player when the purpose is listening rather than creating."}],aesthetics:[{id:"professional_dark_workspace",name:"Professional Dark Workspace",description:"Color palette: charcoal #1C1E22 with flat opaque panels at #25282E, off-white text, one amber #E0A020. Type: compact sans for chrome, monospace for metadata, coordinates, and values. Structure: dense tool panels flanking a large central work area, 4px radii, hairline separators, no glow, no gradients, no wallpaper. Signature: flat opaque panels around a large canvas, with a monospaced metadata strip. Never: any transparency or blur, visible wallpaper, saturated multi-hue icons, large radii, or a light ground."},{id:"swiss_utility",name:"Swiss Utility",description:"Color palette: true white, black, one red #E63312. Type: neo-grotesque; toolbars built from small all-caps text labels rather than icons. Structure: a visible modular grid, hairline rules separating regions, 0px radii, exact alignment, tight toolbars, minimal iconography. Signature: toolbars composed of text labels and rules instead of icon glyphs. Never: icon-only chrome, a single centered object with empty surroundings, soft shadows, tinted panels, or vivid green."},{id:"frosted_system",name:"Frosted System",description:"Color palette: a light blurred wallpaper moving from muted blue-gray #9FB2C4 to sand #DCCDB4, with translucent white surfaces over it, near-black type, and a saturated multi-hue application icon set. Type: crisp contemporary sans; no monospace anywhere. Structure: translucent panels at 16\u201320px radii, subtle localized blur that never reduces legibility, simple line icons, layered depth. Signature: light translucent panels with wallpaper color visibly reading through them. Never: dark mode, opaque flat panels, monospace, amber, hairline rules, or 0px radii."},{id:"white_appliance",name:"White Appliance",description:"Color palette: pure white, pale gray #EEEEEE support elements, one electric green #00C853. Type: compact geometric sans, small, used sparingly. Structure: a single large centered canvas, tool, or output. Controls reduced to minimal icon glyphs. No rules, no borders, no visible grid, no shadows. Enormous negative space. Signature: one centered object with almost nothing else on screen. Never: text-label toolbars, visible modular grids, hairline rules, dense panels, or red accents."},{id:"light_pro_workspace",name:"Light Pro Workspace",description:"Color palette: cool white #F7F8FA, light-gray panels #ECEFF3, graphite #25282D, and one restrained indigo #4F63D8. Type: compact neutral sans for chrome, navigation, and controls; monospace restricted to timecodes, coordinates, values, or technical metadata. Structure: a broad central workspace flanked by filled tool panels, icon-forward toolbars, a narrow properties rail, 6px radii, and precise 1px borders. Keep density high enough for professional work while maintaining clear grouping and comfortable spacing. Avoid visible shadows, texture, and ornamental depth. Signature: a large light working canvas framed by tightly organized icon toolbars and a narrow properties panel. Never: cream paper, serif headings, tactile knobs, printed measurement scales, red ink, giant empty appliance-like space, translucent wallpaper, warm studio panels, or skeuomorphic material treatment."},{id:"ink_frame_workspace",name:"Ink Frame Workspace",description:"Color palette: deep ink navy #17202A for persistent application chrome, warm white #F7F5F0 for the main working surface, cool fog gray #E7EBEF for secondary panels, charcoal #23272B for content, and one controlled coral #D16047 for selection, active tools, or the primary action. Type: compact neutral grotesque for menus, tools, navigation, and content; monospace appears only for technical values such as coordinates, timecodes, dimensions, or file metadata. Structure: a fixed dark top bar and narrow left tool rail form an L-shaped application frame around one coherent bright workspace. Optional properties, layers, settings, or history controls appear in a docked right panel rather than as detached floating rectangles. Use horizontal tabs where appropriate, 6px radii, crisp 1px dividers, compact icon-and-label controls, and minimal shadow. The central region should clearly contain the actual product experience\u2014a document, media preview, timeline, file list, settings view, design surface, instrument, or utility output. Signature: a dark ink application frame surrounding a large bright working surface, with a thin coral marker identifying the active tool or selection. Never: scattered content frames, an infinite blank canvas, detached floating panels, visible dot fields, a full-screen dark treatment, translucent wallpaper, ornamental geometry, oversized empty margins around one object, skeuomorphic materials, or decorative diagrams unrelated to the product\u2019s function."},{id:"warm_creative_studio",name:"Warm Creative Studio",description:"Color palette: stone #E9E4DC, cream, warm charcoal, one muted plum #7A5468. Type: refined humanist sans throughout. Structure: a large light canvas with softly separated warm-toned tool panels, 10px radii, restrained asset thumbnails, clear selection states, comfortable spacing. Signature: warm stone panels around a bright canvas with one clearly selected asset. Never: dark mode, technical grids or rulers, monospace, cyan, or amber."},{id:"classic_desktop_modernized",name:"Classic Desktop Modernized",description:"Color palette: warm platinum #DCD8CE chrome with white content areas, near-black text, one ultramarine #2C4EE0 used for selection highlights. Type: a pixel-influenced grotesque, modernized and cleanly rendered. Structure: genuine title bars, a top menu bar with named menus, window controls, sidebars, file and application icons \u2014 all drawn flat with subtle flattened bevels, modest shadows, and crisp spacing. Signature: authentic title bars and a named menu bar, rendered flat and contemporary. Never: navy grids, cyan vectors, rulers, monospace annotation, dark mode, CRT scanlines, or distressed retro texture."}]},{id:"games",name:"Games",appTypes:[{id:"racing_game",name:"Driving / Racing Simulator",surface:"web",description:"A game centered on controlling a car, truck, motorcycle, or other vehicle through a road, course, track, or simulated environment. Prompts may mention racing, driving simulation, parking, delivery driving, open-road exploration, or vehicle customization. The gameplay screen typically contains a vehicle or cockpit view, speed, route or minimap, lap or position information, vehicle status, and driving controls."},{id:"action_game",name:"Action / Adventure Combat Game",surface:"web",description:"A real-time game involving character movement, exploration, combat, platforming, shooting, fighting, missions, or survival. It covers first-person and third-person shooters, action platformers, fighting games, and combat-oriented adventure games. Typical gameplay screens include the player character or weapon, environment, enemies, health, abilities, inventory, objectives, score, and navigation HUD. Use a more specific puzzle or card bucket when combat and movement are not central."},{id:"puzzle_game",name:"Puzzle / Logic Game",surface:"web",description:"A game centered on solving structured mental, spatial, word, number, matching, physics, or pattern-based challenges. The main screen usually contains a puzzle board, grid, objects, clues, level goal, move or time limit, score, progress, and hint controls. Match prompts for match-three games, word puzzles, Sudoku-like games, block puzzles, escape puzzles, or logic challenges where solving the puzzle is the primary interaction."},{id:"tabletop_game",name:"Card / Tabletop Game",surface:"web",description:"A digital game modeled around cards, decks, boards, tiles, turns, hands, or tabletop rules. It includes collectible card games, traditional card games, solitaire, poker-like experiences, board games, and strategy games with visible tabletop state. Typical screens show the player\u2019s hand or pieces, opponent state, deck or board, score, resources, turn indicator, available actions, and game history."}],aesthetics:[{id:"stylized_realism",name:"Stylized Realism",description:"Rendering: physically-based materials with believable surface texture, a desaturated natural color grade, volumetric directional light, atmospheric depth and haze, soft contact shadows, and gentle ambient occlusion. No outlines anywhere. Shapes are simplified and deliberately designed, but shading is continuous rather than banded. HUD: minimal and diegetic where possible, thin neutral sans, few overlays. Signature: convincing light and material sitting on simplified, authored forms. Never: black ink outlines, flat color fills, two-tone cel banding, high saturation, comic-flat skies, or promotional key-art framing."},{id:"low_poly_modern",name:"Low-Poly Modern",description:"Rendering: faceted geometry with visible flat planes, matte untextured materials, a strict four-color palette, soft directional light, broad readable silhouettes. HUD: minimal geometric sans, flat panels. Signature: visible flat facets catching directional light. Never: outlines, texture maps, photorealistic materials, atmospheric haze, or brush texture."},{id:"isometric_diorama",name:"Isometric Diorama",description:"Rendering: a fixed isometric camera looking onto a carefully constructed miniature environment. Use smooth, subtly beveled geometry rather than visible low-poly facets; matte materials with restrained real-world cues; a controlled palette of moss, clay, limestone, slate, and subdued sky blue; soft directional light; and tight contact shadows. Do not use exaggerated depth of field. HUD: compact neutral sans, edge-aligned information, small opaque panels, and minimal overlays that do not obscure the scene. Signature: a believable miniature world shown from a consistent isometric angle, with architecture and gameplay objects arranged for immediate readability. Never: visible brushwork, watercolor edges, paper layers, faceted low-poly planes, pixel grids, black outlines, photorealistic key art, ornamental frames, or cinematic camera blur."},{id:"graphic_noir",name:"Graphic Noir",description:"Rendering: black, white, and layered gray with one restrained amber #D89B2C. Hard-edged cast shadows as compositional shapes, strong silhouettes, high contrast, flat tonal separation. HUD: condensed sans, sparse. Signature: hard cast-shadow shapes driving the composition. Never: smoke, film grain, lens flare, color grading effects, brush texture, or saturated color."},{id:"refined_pixel",name:"Refined Pixel",description:"Rendering: crisp pixel art at a single consistent pixel scale with a disciplined limited palette and clearly designed silhouettes. No anti-aliasing between resolutions. HUD: bitmap type used selectively; menus, counters, and panels cleanly aligned with modern spacing. Signature: a uniform pixel grid paired with contemporary interface spacing. Never: mixed pixel resolutions, blur, gradient shading, brush texture, or cluttered nostalgic HUDs."},{id:"cel_shaded_graphic",name:"Cel-Shaded Graphic",description:"Rendering: high-saturation flat color fills, hard black ink outlines of varying weight on every form, exactly two shadow tones and no more, no gradients, no texture, no ambient occlusion, no atmospheric depth, flat solid-color sky. HUD: bold geometric or condensed sans on flat opaque panels, high legibility. Signature: ink outlines plus strictly two-tone shading. Never: soft or continuous shading, contact shadows, volumetric light, material realism, desaturated grading, or haze."},{id:"modern_arcade_graphic",name:"Modern Arcade Graphic",description:"Rendering: flat vector-like 2D or restrained 2.5D forms using a strict four-color system such as ink navy, warm cream, vermilion, and muted mint. Use bold geometric silhouettes, large hard-edged color fields, crisp overlap, and simple plane separation. Build energy through scale, rhythm, direction, and movement rather than lighting effects. HUD: bold geometric or condensed sans, sharply aligned score and objective panels, compact counters, and consistent 0\u20134px radii. Signature: full-canvas gameplay composed from large flat shapes and a disciplined four-color graphic system. Never: cut-paper edges, physical drop shadows, cardstock texture, brushwork, pixel rendering, heavy ink outlines, realistic materials, luminous gradients, broad multicolor palettes, or so much empty space that the playfield loses energy and hierarchy."},{id:"minimal_strategy",name:"Minimal Strategy",description:"Rendering: off-white ground, charcoal linework, one strong accent. An abstract board, map, track, or arena built from thin lines and modular geometric tokens. Large negative space. HUD: precise neo-grotesque type, sparse status information. Signature: geometric tokens on a thin-lined board surrounded by generous white space. Never: illustrated environments, textures, painted surfaces, atmospheric lighting, or HUD clutter."}]}]:null;function s(e){return n.find(t=>t.appTypes.some(t=>t.id===e))}function r(e){return s(e)?.appTypes.find(t=>t.id===e)}function i(e){return s(e)?.aesthetics??[]}a.d(t,{G0:()=>i,bX:()=>r},{Lo:"landing_page"})}}]);

//# debugId=708ba660-4b36-5acb-b48b-6c4c2b1d60bb

//# sourceMappingURL=https://admin.figma.com/admin/webpack-artifacts/921c03455a02947d3e580481d1e802f46e0c53a5/2703-08c1ee4877e86e0a.min.js.map